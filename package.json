{
  "name": "mdac-oneclick",
  "version": "0.2.1",
  "private": true,
  "description": "Chrome extension: fill the Malaysia Digital Arrival Card (MDAC) from saved travellers in one click.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test --project=e2e",
    "qc": "pnpm build && playwright test --project=qc",
    "zip": "pnpm build && node scripts/zip.mjs",
    "reference": "node scripts/build-reference.mjs",
    "store-assets": "pnpm build && node scripts/store-assets.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "bootstrap-datepicker": "^1.10.1",
    "esbuild": "^0.28.2",
    "jquery": "^4.0.0",
    "jsdom": "^30.1.3",
    "tesseract.js": "7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "tesseract.js-core": "7.0.0"
    }
  }
}
